# Go build output
/explorer
*.exe
*.test
*.out

# Web dependencies (SPA build output `internal/server/ui/dist/` is committed
# so `go install` / `go run` from the module path produces a working binary)
web/node_modules/

# Skill-local node_modules (record-demo-gif's CDP client uses `ws`)
.claude/skills/*/node_modules/
.claude/skills/*/package-lock.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Release archives (produced by `make release-snapshot` / GitHub Actions).
# Anchored at the repo root so the SPA build output at
# `internal/server/ui/dist/` (which IS committed; see note above) is not ignored.
/dist/

# Generated fixture repo for git-reader tests (created by `make sample-repo`).
# Nested .git/ is intentionally never committed.
/testdata/sample-repo/

# Playwright e2e test artifacts
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/
/e2e/.cache/